{
    "layer": "top",
    "position": "top",
    "height": 28,

    "modules-left": ["hyprland/workspaces"],
    "modules-right": ["tray", "pulseaudio", "battery", "clock"],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " muted",
        "tooltip-format": "{desc}"
    },
    "battery": {
        "format": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "tooltip-format": "{time}",
        "format-time": "{H}h{M}m"
    },
    "tray": {
        "spacing": 10,
    },
    "clock": {
        "format": " {:%H:%M}",
        "tooltip-format": "{:%a %d %b}",
    }
}
